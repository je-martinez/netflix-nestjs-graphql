---
import BaseLayout from '../layouts/BaseLayout.astro';
import MovieGrid from '../features/catalog/components/MovieGrid.astro';
import MovieModal from '../features/movie-details/components/MovieModal.astro';
import { getMovies } from '../features/catalog/services/movies.service';

const movies = await getMovies();
---

<BaseLayout
  title="NETFLIX | Special Features"
  description="Explore bonus content, director's cuts, behind-the-scenes footage and exclusive extras from the digital vault."
>
  <MovieGrid movies={movies} />
  <MovieModal slot="modal" />
</BaseLayout>
