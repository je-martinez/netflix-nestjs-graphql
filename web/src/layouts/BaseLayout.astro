---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  section?: 'movies' | 'tv-series' | 'special-features' | 'my-shelf' | 'settings';
  subsection?: string;
}

const {
  title = 'NETFLIX',
  description = 'A curated digital vault of cinematic classics. Browse our catalog of handpicked DVD-era films.',
  section = 'movies',
  subsection = 'home',
} = Astro.props;

const subLinks = (base: string) => [
  { href: `/${base}/home`,         icon: 'home',      label: 'Home' },
  { href: `/${base}/new-releases`, icon: 'fiber_new', label: 'New Releases' },
  { href: `/${base}/genres`,       icon: 'category',  label: 'Genres' },
];

const sidebarLinks: Record<string, { href: string; icon: string; label: string }[]> = {
  movies:             subLinks('movies'),
  'tv-series':        subLinks('tv-series'),
  'special-features': subLinks('special-features'),
};

const navSection = section in sidebarLinks ? section : 'movies';
const currentLinks = sidebarLinks[navSection];
const currentPath  = Astro.url.pathname;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
    <ClientRouter />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Epilogue:wght@700;800;900&family=Space+Grotesk:wght@400;500;700&family=Work+Sans:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body
    class="bg-surface text-on-surface font-body selection:bg-secondary-container selection:text-on-secondary-container"
  >
    <!-- Top Nav -->
    <header
      class="fixed inset-x-0 top-0 z-50 bg-brand-dark flex justify-between items-center px-8 py-4 shadow-2xl shadow-black"
      transition:persist
    >
      <div class="flex items-center gap-8">
        <a
          href="/"
          class="text-2xl font-black italic uppercase tracking-tighter font-headline text-brand"
          aria-label="NETFLIX home"
        >
          NETFLIX
        </a>
        <nav class="hidden md:flex items-center gap-6 relative" aria-label="Main navigation">
          <span
            id="nav-indicator"
            class="absolute bottom-[-6px] h-[2px] bg-brand-yellow"
            aria-hidden="true"
          ></span>
          <a
            class="font-headline font-bold tracking-tight text-brand-text hover:text-brand-yellow transition-colors duration-300 pb-1"
            data-nav-link
            href="/movies/home"
          >
            Movies
          </a>
          <a
            class="font-headline font-bold tracking-tight text-brand-text hover:text-brand-yellow transition-colors duration-300 pb-1"
            data-nav-link
            href="/tv-series/home"
          >
            TV Series
          </a>
          <a
            class="font-headline font-bold tracking-tight text-brand-text hover:text-brand-yellow transition-colors duration-300 pb-1"
            data-nav-link
            href="/special-features/home"
          >
            Special Features
          </a>
        </nav>
      </div>

      <div class="flex items-center gap-4">
        <div class="relative hidden lg:block">
          <span
            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm"
            aria-hidden="true"
          >
            search
          </span>
          <label for="vault-search" class="sr-only">Search the vault</label>
          <input
            id="vault-search"
            class="bg-surface-container-low border-none focus:ring-1 focus:ring-primary-container text-xs font-label tracking-widest pl-10 pr-4 py-2 w-64 rounded-lg"
            placeholder="SEARCH VAULT..."
            type="search"
            aria-label="Search movies"
          />
        </div>
        <button
          class="scale-95 active:opacity-80 text-brand-text hover:text-brand-yellow transition-colors duration-300"
          aria-label="Account"
        >
          <span class="material-symbols-outlined text-3xl" aria-hidden="true">account_circle</span>
        </button>
      </div>
    </header>

    <div class="mt-[73px] bg-gradient-to-b from-surface-container-highest to-brand-dark h-1"></div>

    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside
        class="hidden md:flex h-full w-64 fixed left-0 bg-brand-dark flex-col p-6 space-y-8 shadow-[20px_0_40px_rgba(0,0,0,0.8)] border-r border-white/5 z-40"
        aria-label="Sidebar navigation"
      >
        <div class="space-y-1">
          <p class="font-label uppercase text-xs tracking-widest text-brand-yellow">Member Since '04</p>
          <p class="font-label uppercase text-[10px] tracking-[0.2em] text-brand-text/60">
            Premium Tier
          </p>
        </div>

        <nav class="flex flex-col gap-1" aria-label="Sidebar links">
          {currentLinks.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <a
                href={link.href}
                data-sidebar-link
                class={`font-label uppercase text-xs tracking-widest flex items-center gap-2 transition-all duration-200 ease-in-out py-2 px-1 ${
                  isActive
                    ? 'text-brand-yellow before:content-["▶"] before:text-[8px]'
                    : 'text-brand-text/60 hover:bg-white/5 hover:text-white rounded'
                }`}
              >
                <span class="material-symbols-outlined text-lg" aria-hidden="true">{link.icon}</span>
                {link.label}
              </a>
            );
          })}

          <div class="my-4 border-t border-white/5"></div>

          <a
            href="/my-shelf"
            data-sidebar-link
            class={`font-label uppercase text-xs tracking-widest flex items-center gap-2 transition-all duration-200 ease-in-out py-2 px-1 ${
              section === 'my-shelf'
                ? 'text-brand-yellow before:content-["▶"] before:text-[8px]'
                : 'text-brand-text/60 hover:bg-white/5 hover:text-white rounded'
            }`}
          >
            <span class="material-symbols-outlined text-lg" aria-hidden="true">inventory_2</span>
            My Shelf
          </a>
          <a
            href="/settings"
            data-sidebar-link
            class={`font-label uppercase text-xs tracking-widest flex items-center gap-2 transition-all duration-200 ease-in-out py-2 px-1 ${
              section === 'settings'
                ? 'text-brand-yellow before:content-["▶"] before:text-[8px]'
                : 'text-brand-text/60 hover:bg-white/5 hover:text-white rounded'
            }`}
          >
            <span class="material-symbols-outlined text-lg" aria-hidden="true">settings</span>
            Settings
          </a>
        </nav>

        <div class="pt-8">
          <button
            class="w-full bg-primary-container text-on-primary-container py-3 font-label font-bold tracking-widest text-xs rounded-lg hover:shadow-[0_0_20px_rgba(229,9,20,0.4)] transition-all active:scale-95"
          >
            RENT NOW
          </button>
        </div>
      </aside>

      <!-- Main slot -->
      <main class="flex-1 md:ml-64 p-8 pb-24" id="main-content">
        <slot />

        <!-- Footer ledge -->
        <div
          class="mt-20 h-24 w-full bg-gradient-to-t from-surface-container-low to-transparent rounded-t-xl border-t border-white/5 p-8"
          aria-hidden="true"
        >
          <div class="flex justify-between items-center opacity-30">
            <div class="flex gap-4">
              <span class="material-symbols-outlined">movie</span>
              <span class="material-symbols-outlined">hd</span>
              <span class="material-symbols-outlined">subtitles</span>
            </div>
            <p class="font-label text-[8px] tracking-[0.4em] uppercase">
              Digital Rental Archive v2.4.0 • Regional Locked
            </p>
          </div>
        </div>
      </main>
    </div>

    <!-- Bottom nav (mobile) -->
    <nav
      class="md:hidden fixed bottom-0 left-0 w-full flex justify-around items-center py-3 px-4 bg-brand-dark z-50 border-t border-white/10 shadow-[0_-10px_30px_rgba(0,0,0,0.9)]"
      aria-label="Mobile navigation"
    >
      <a class="flex flex-col items-center justify-center text-brand-yellow scale-110" href="/">
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;" aria-hidden="true"
          >grid_view</span
        >
        <span class="font-label text-[10px] uppercase font-bold mt-1">Catalog</span>
      </a>
      <button
        class="flex flex-col items-center justify-center text-brand-text/40 active:scale-90 transition-transform"
        aria-label="Search"
      >
        <span class="material-symbols-outlined" aria-hidden="true">search</span>
        <span class="font-label text-[10px] uppercase font-bold mt-1">Search</span>
      </button>
      <button
        class="flex flex-col items-center justify-center text-brand-text/40 active:scale-90 transition-transform"
        aria-label="Favorites"
      >
        <span class="material-symbols-outlined" aria-hidden="true">favorite</span>
        <span class="font-label text-[10px] uppercase font-bold mt-1">Favorites</span>
      </button>
      <button
        class="flex flex-col items-center justify-center text-brand-text/40 active:scale-90 transition-transform"
        aria-label="Account"
      >
        <span class="material-symbols-outlined" aria-hidden="true">person</span>
        <span class="font-label text-[10px] uppercase font-bold mt-1">Account</span>
      </button>
    </nav>

    <!-- Modal portal — outside all stacking contexts -->
    <slot name="modal" />

    <script>
      import { gsap } from 'gsap';

      const ROUTES = ['/movies', '/tv-series', '/special-features'];
      let slideDirection = 1;

      function updateActiveLinks(pathname: string, animate = true) {
        const indicator = document.getElementById('nav-indicator');
        const nav = indicator?.parentElement;
        const section = '/' + pathname.split('/')[1];

        document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
          const isActive = '/' + a.pathname.split('/')[1] === section;
          a.classList.toggle('text-brand-yellow', isActive);
          a.classList.toggle('text-brand-text', !isActive);

          if (isActive && indicator && nav) {
            const navRect = nav.getBoundingClientRect();
            const aRect = a.getBoundingClientRect();
            if (animate) {
              gsap.to(indicator, { left: aRect.left - navRect.left, width: aRect.width, duration: 0.35, ease: 'power2.inOut' });
            } else {
              gsap.set(indicator, { left: aRect.left - navRect.left, width: aRect.width });
            }
          }
        });

        document.querySelectorAll<HTMLAnchorElement>('[data-sidebar-link]').forEach((a) => {
          const isActive = a.pathname === pathname;
          a.classList.toggle('text-brand-yellow', isActive);
          a.classList.toggle('before:content-["▶"]', isActive);
          a.classList.toggle('before:text-[8px]', isActive);
          a.classList.toggle('text-brand-text/60', !isActive);
          a.classList.toggle('hover:bg-white/5', !isActive);
          a.classList.toggle('hover:text-white', !isActive);
          a.classList.toggle('rounded', !isActive);
        });
      }

      let firstLoad = true;

      function pageEnter() {
        updateActiveLinks(window.location.pathname, !firstLoad);
        firstLoad = false;
        const main = document.getElementById('main-content');
        if (!main) return;
        gsap.fromTo(main, { opacity: 0 }, {
          opacity: 1,
          duration: 0.5,
          ease: 'power2.out',
          onComplete: () => { main.removeAttribute('style'); },
        });
      }

      // Intercept header nav clicks to preserve subsection across sections
      document.addEventListener('click', (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>('[data-nav-link]');
        if (!link) return;

        e.preventDefault();
        const targetSection = link.pathname.split('/')[1]; // e.g. "movies"
        const currentSubsection = window.location.pathname.split('/')[2] ?? 'home'; // e.g. "new-releases"
        const dest = `/${targetSection}/${currentSubsection}`;

        if (dest !== window.location.pathname) {
          window.location.href = dest;
        }
      });

      document.addEventListener('astro:page-load', pageEnter);

      document.addEventListener('astro:before-preparation', (e: Event) => {
        const nav = e as { to?: URL; cancel: () => void };
        const to = nav.to?.pathname ?? '/';

        if (to === window.location.pathname) {
          nav.cancel();
          return;
        }

        const fromSection = '/' + window.location.pathname.split('/')[1];
        const toSection   = '/' + to.split('/')[1];
        const fromIndex = ROUTES.indexOf(fromSection);
        const toIndex   = ROUTES.indexOf(toSection);
        slideDirection = toIndex >= fromIndex ? 1 : -1;

        const main = document.getElementById('main-content');
        if (main) gsap.to(main, { opacity: 0, duration: 0.3, ease: 'power2.in' });
      });
    </script>
  </body>
</html>
