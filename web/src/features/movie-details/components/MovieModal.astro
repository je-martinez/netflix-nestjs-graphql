---
import type { Movie } from '../../catalog/types/movie.types';
import { MOCK_MOVIES } from '../../catalog/services/movies.mock';

// Pre-render modal content for all movies (SSG)
const movies = MOCK_MOVIES;
---

<!-- Movie Details Modal Backdrop -->
<div
  id="movie-modal"
  class="fixed inset-0 z-[200] hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <!-- Backdrop -->
  <div
    id="modal-backdrop"
    class="absolute inset-0 bg-black/80 backdrop-blur-sm"
    aria-hidden="true"
  ></div>

  <!-- Modal Panel -->
  <div
    class="relative z-10 flex items-center justify-center min-h-screen p-4 md:p-8"
  >
    <div
      id="modal-content"
      class="w-full max-w-5xl bg-surface-container-low rounded-lg shadow-[0_40px_100px_rgba(0,0,0,0.9)] overflow-hidden max-h-[90vh] overflow-y-auto overscroll-contain"
    >
      <!-- Close button -->
      <button
        id="modal-close"
        class="absolute top-4 right-4 z-20 text-on-surface/60 hover:text-secondary-container transition-colors bg-surface-container p-2 rounded-lg"
        aria-label="Close movie details"
      >
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>

      <!-- Dynamic content injected by JS -->
      <div id="modal-inner" class="relative">
        <!-- Templates for each movie pre-rendered -->
        {movies.map((movie) => {
          const runtimeHours = Math.floor(movie.runtime / 60);
          const runtimeMins = movie.runtime % 60;
          const runtimeLabel = runtimeHours > 0
            ? `${runtimeHours}H ${runtimeMins}MIN`
            : `${runtimeMins} MIN`;

          return (
            <template data-movie-template={movie.id}>
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 relative">
                <!-- DVD Spine -->
                <div class="hidden lg:block lg:col-span-1 bg-surface-container-high border-r border-white/5 relative overflow-hidden">
                  <div class="absolute inset-y-0 left-0 w-1 bg-white/10"></div>
                  <div class="flex flex-col items-center justify-between h-full py-12 px-2">
                    <span class="material-symbols-outlined text-on-surface-variant/20 scale-150" aria-hidden="true">movie</span>
                    <h2
                      class="font-headline font-black text-xl text-on-surface-variant/10 uppercase tracking-[0.5em]"
                      style="writing-mode: vertical-lr; transform: rotate(180deg);"
                    >
                      {movie.title}
                    </h2>
                    <div class="flex flex-col gap-4 items-center">
                      <div class="w-6 h-6 border border-on-surface-variant/20 flex items-center justify-center text-[10px] font-label text-on-surface-variant/40">
                        1
                      </div>
                      <span class="material-symbols-outlined text-on-surface-variant/20" aria-hidden="true">subtitles</span>
                    </div>
                  </div>
                </div>

                <!-- Main Content -->
                <div class="lg:col-span-11 p-8 md:p-12 lg:p-16 relative">
                  <div class="absolute inset-0 dvd-sheen pointer-events-none" aria-hidden="true"></div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 relative z-10">

                    <!-- Left: Story & Info -->
                    <div class="space-y-8">
                      <div>
                        <h1
                          id="modal-title"
                          class="text-secondary-container font-headline text-5xl md:text-6xl font-black italic tracking-tighter mb-2 uppercase"
                        >
                          {movie.title}
                        </h1>
                        <div class="flex gap-4 font-label text-xs tracking-tighter text-on-surface/50 uppercase">
                          <span>{movie.year}</span>
                          <span>•</span>
                          <span>{runtimeLabel}</span>
                          <span>•</span>
                          <span>ANAMORPHIC WIDESCREEN</span>
                        </div>
                      </div>

                      <div class="space-y-4">
                        <p class="font-body text-lg leading-relaxed text-on-surface/90">
                          {movie.synopsis}
                        </p>
                        <div class="grid grid-cols-2 gap-4 pt-4">
                          <div>
                            <h4 class="font-label text-[10px] text-primary-container font-bold tracking-widest uppercase mb-1">
                              Starring
                            </h4>
                            <p class="text-sm font-medium">{movie.starring.join(', ')}</p>
                          </div>
                          <div>
                            <h4 class="font-label text-[10px] text-primary-container font-bold tracking-widest uppercase mb-1">
                              Director
                            </h4>
                            <p class="text-sm font-medium">{movie.director}</p>
                          </div>
                        </div>
                      </div>

                      <div class="pt-8">
                        <button
                          class="bg-primary-container text-on-primary-container flex items-center gap-4 px-10 py-5 rounded-lg font-headline text-xl font-black tracking-widest remote-glow active:scale-95 transition-all"
                          aria-label={`Play ${movie.title}`}
                        >
                          <span
                            class="material-symbols-outlined text-3xl"
                            style="font-variation-settings: 'FILL' 1;"
                            aria-hidden="true"
                          >
                            play_arrow
                          </span>
                          PLAY MOVIE
                        </button>
                      </div>
                    </div>

                    <!-- Right: Menu Features -->
                    <div class="space-y-10">
                      <!-- Scene Selection -->
                      <section aria-labelledby={`scenes-${movie.id}`}>
                        <div class="flex items-center justify-between mb-4 border-b border-white/5 pb-2">
                          <h3
                            id={`scenes-${movie.id}`}
                            class="font-label text-xs font-bold tracking-[0.2em] uppercase text-on-surface/40"
                          >
                            Scene Selection
                          </h3>
                          <span class="text-[10px] font-label text-secondary-container">
                            {movie.chapters.length} CHAPTERS
                          </span>
                        </div>
                        <div class="grid grid-cols-3 gap-3" role="list" aria-label="Scene thumbnails">
                          {movie.chapters.map((ch) => (
                            <div
                              class="relative aspect-video bg-surface-container-highest group cursor-pointer overflow-hidden border border-white/5"
                              role="listitem"
                            >
                              <img
                                class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity"
                                src={ch.thumbnailUrl}
                                alt={`Chapter ${ch.number}: ${ch.title}`}
                                loading="lazy"
                                decoding="async"
                                width="150"
                                height="85"
                              />
                              <div class="absolute inset-0 flex items-center justify-center bg-black/40 group-hover:bg-transparent transition-colors">
                                <span class="font-label text-[10px] font-bold">
                                  {String(ch.number).padStart(2, '0')} {ch.title}
                                </span>
                              </div>
                            </div>
                          ))}
                        </div>
                      </section>

                      <!-- Bonus Materials -->
                      <section aria-labelledby={`bonus-${movie.id}`}>
                        <div class="flex items-center justify-between mb-4 border-b border-white/5 pb-2">
                          <h3
                            id={`bonus-${movie.id}`}
                            class="font-label text-xs font-bold tracking-[0.2em] uppercase text-on-surface/40"
                          >
                            Bonus Materials
                          </h3>
                        </div>
                        <ul class="space-y-3 font-label text-sm list-none p-0 m-0">
                          {movie.bonusMaterials.map((item) => (
                            <li
                              class={`flex items-center gap-3 cursor-pointer ${
                                item.active
                                  ? 'text-secondary-container group'
                                  : 'text-on-surface/60 hover:text-on-surface transition-colors'
                              }`}
                            >
                              {item.active ? (
                                <span class="text-[8px]">▶</span>
                              ) : (
                                <span class="material-symbols-outlined text-sm" aria-hidden="true">
                                  {item.icon}
                                </span>
                              )}
                              <span class="uppercase tracking-widest group-hover:underline">
                                {item.label}
                              </span>
                            </li>
                          ))}
                        </ul>
                      </section>

                      <!-- Technical Specs -->
                      <div class="pt-6 flex gap-8" aria-label="Technical specifications">
                        <div class="flex flex-col items-center gap-1 opacity-30">
                          <span class="material-symbols-outlined text-3xl" aria-hidden="true">surround_sound</span>
                          <span class="text-[8px] font-label uppercase">{movie.technicalSpecs.audio}</span>
                        </div>
                        <div class="flex flex-col items-center gap-1 opacity-30">
                          <span class="material-symbols-outlined text-3xl" aria-hidden="true">hd</span>
                          <span class="text-[8px] font-label uppercase">{movie.technicalSpecs.resolution}</span>
                        </div>
                        <div class="flex flex-col items-center gap-1 opacity-30">
                          <span class="material-symbols-outlined text-3xl" aria-hidden="true">language</span>
                          <span class="text-[8px] font-label uppercase">{movie.technicalSpecs.region}</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Barcode footer -->
                  <div class="mt-16 flex items-end justify-between border-t border-white/5 pt-8" aria-hidden="true">
                    <div class="flex gap-4 items-center">
                      <div class="bg-on-surface h-12 w-24 flex items-end justify-between p-1">
                        {[1, 2, 1, 4, 1, 2, 3, 1].map((w, i) => (
                          <div class={`w-[${w}px] h-full bg-black`} style={`width:${w}px`} />
                        ))}
                      </div>
                      <div class="text-[10px] font-label uppercase leading-tight text-on-surface/30">
                        Edition: Archive {movie.year}<br />
                        Stock #: {movie.stockNumber}
                      </div>
                    </div>
                    <div class="text-on-surface-variant/20 font-headline font-black italic text-xl">
                      DVD VIDEO™
                    </div>
                  </div>
                </div>
              </div>
            </template>
          );
        })}
      </div>
    </div>
  </div>
</div>

<script>
  function initModal() {
    const modal = document.getElementById('movie-modal');
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close');
    const inner = document.getElementById('modal-inner');
    if (!modal || !backdrop || !closeBtn || !inner) return;

    function openModal(movieId: string) {
      const tmpl = inner!.querySelector<HTMLTemplateElement>(
        `template[data-movie-template="${movieId}"]`
      );
      if (!tmpl) return;

      const existing = inner!.querySelector('[data-rendered]');
      if (existing) existing.remove();

      const clone = tmpl.content.cloneNode(true) as DocumentFragment;
      const wrapper = document.createElement('div');
      wrapper.dataset.rendered = movieId;
      wrapper.appendChild(clone);
      inner!.appendChild(wrapper);

      modal!.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      closeBtn!.focus();
    }

    function closeModal() {
      modal!.classList.add('hidden');
      document.body.style.overflow = '';

      const rendered = inner!.querySelector('[data-rendered]');
      const activeCard = document.querySelector<HTMLElement>(
        `[data-movie-id="${(rendered as HTMLElement)?.dataset.rendered}"]`
      );
      activeCard?.focus();
      rendered?.remove();
    }

    document.addEventListener('click', (e) => {
      const card = (e.target as Element).closest<HTMLElement>('[data-movie-id]');
      if (card?.dataset.movieId) openModal(card.dataset.movieId);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const card = (document.activeElement as HTMLElement).closest<HTMLElement>('[data-movie-id]');
        if (card?.dataset.movieId) {
          e.preventDefault();
          openModal(card.dataset.movieId);
        }
      }
      if (e.key === 'Escape') closeModal();
    });

    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
  }

  // Runs on first load and after every View Transition navigation
  document.addEventListener('astro:page-load', initModal);
</script>
