---
import type { Movie } from '../types/movie.types';

interface Props {
  movie: Movie;
}

const { movie } = Astro.props;
const runtimeHours = Math.floor(movie.runtime / 60);
const runtimeMins = movie.runtime % 60;
const runtimeLabel = runtimeHours > 0 ? `${runtimeHours}H ${runtimeMins}MIN` : `${runtimeMins} MIN`;
---

<article
  class="group relative flex flex-col gap-4 cursor-pointer"
  data-movie-id={movie.id}
  data-testid="movie-card"
  role="button"
  tabindex="0"
  aria-label={`View details for ${movie.title}`}
>
  <div class="relative w-full aspect-[2/2.8]">
    <!-- Peeking DVD disc -->
    <div
      class="absolute right-0 top-1/2 -translate-y-1/2 w-[85%] h-[85%] rounded-full bg-stone-900 shadow-2xl border border-white/10 overflow-hidden transition-all duration-500 group-hover:translate-x-[45%] translate-x-[2%] z-0 disc-rainbow"
      aria-hidden="true"
    >
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="w-1/4 h-1/4 rounded-full bg-[#111317] border border-white/20 shadow-inner"></div>
      </div>
    </div>

    <!-- DVD Case -->
    <div
      class="relative h-full w-full rounded-[4px] bg-[#0c0c0c] p-[3px] shadow-[15px_15px_40px_rgba(0,0,0,0.85),inset_0_1px_1px_rgba(255,255,255,0.1)] transition-transform duration-300 group-hover:-translate-y-2 z-10 dvd-bezel overflow-hidden"
    >
      <div class="relative h-full w-full overflow-hidden rounded-[2px] bg-black">
        <img
          src={movie.posterUrl}
          alt={`${movie.title} movie poster`}
          class="w-full h-full object-cover opacity-90"
          loading="lazy"
          decoding="async"
          width="200"
          height="280"
        />
        <div class="absolute inset-0 plastic-texture pointer-events-none" aria-hidden="true"></div>
        <div class="absolute inset-0 dvd-sheen pointer-events-none" aria-hidden="true"></div>
        <div class="absolute inset-y-0 left-0 w-[18px] dvd-spine pointer-events-none" aria-hidden="true"></div>
        <div class="absolute top-2 right-4 opacity-20 pointer-events-none" aria-hidden="true">
          <p class="font-label text-[7px] tracking-widest text-white uppercase">DIGITAL ARCHIVE</p>
        </div>
        <div class="absolute bottom-3 left-7 opacity-20 pointer-events-none" aria-hidden="true">
          <span class="material-symbols-outlined text-[12px] text-white">movie</span>
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-1 px-1 mt-2">
    <h3 class="font-headline font-bold text-sm leading-tight text-on-surface group-hover:text-secondary-container transition-colors uppercase">
      {movie.title}
    </h3>
    <div class="flex justify-between items-center">
      <p class="font-label text-[10px] text-on-surface-variant tracking-widest uppercase">
        {movie.year} • {runtimeLabel}
      </p>
      <span
        class="text-[8px] border border-white/10 px-1 rounded text-on-surface-variant font-bold"
        aria-label={`Rated ${movie.rating}`}
      >
        {movie.rating}
      </span>
    </div>
  </div>
</article>
